---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import Facets from '../components/Facets.astro';
import JobList from '../components/JobList.astro';
import CommonInfo from '../components/CommonInfo.astro';
import Overview from '../components/Overview.astro';
import { loadJobs } from '../lib/jobLoader.js';
import { withBase } from '../lib/paths.js';

const { jobs, meta } = await loadJobs();
const technicalCount = jobs.filter((j) => j.focus === 'technical').length;
---

<BaseLayout count={meta.count} dataAsOfDay={meta.dataAsOfDay}>
  <section class="intro">
    <h1>Find your ESA internship</h1>
    <p>
      {meta.count} internships across {meta.sites.length} sites, {technicalCount} of them technical, engineering or
      science roles — listed first. Filter by field, site and eligibility, or search for the tools and topics you know.
    </p>
  </section>

  <div
    id="app"
    data-index-url={withBase('search-index.json')}
    data-data-as-of={meta.dataAsOfDay}
  >
    <div class="tabs" role="tablist" aria-label="Views">
      <button type="button" role="tab" id="tab-explore" aria-controls="panel-explore" aria-selected="true">List</button>
      <button type="button" role="tab" id="tab-overview" aria-controls="panel-overview" aria-selected="false" tabindex="-1">Overview</button>
    </div>

    <p class="notice" id="notice" role="status" hidden></p>

    <section id="panel-explore" role="tabpanel" aria-labelledby="tab-explore">
      <div class="explore">
        <Facets meta={meta} />
        <div class="results">
          <SearchBar />
          <JobList jobs={jobs} />
        </div>
      </div>
      <CommonInfo common={meta.common} />
    </section>

    <section id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" hidden>
      <Overview meta={meta} />
    </section>
  </div>

  <script>
    import { initExplorer } from '../scripts/state.js';
    initExplorer();
  </script>
</BaseLayout>
